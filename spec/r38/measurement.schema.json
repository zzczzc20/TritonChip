{
  "schema": "r38-record-schema/1",
  "describes": "archbench-measurement/1",
  "contract": "roadmap section 13.2; doc/r38_stage1_tasks_and_acceptance.md S1-03 and rules R3, R4",
  "format": "Each field: type (str|int|float|bool|object|hash), nullable, enum, unit. `positive_or_null` fields are measurements: a real measurement of them cannot be zero, so a zero is a filled-in unknown and is refused. `stage1_null` fields cannot be measured without a board and must be null in Stage 1.",
  "fields": {
    "schema":            {"type": "str", "enum": ["archbench-measurement/1"]},
    "candidate_hash":    {"type": "hash"},
    "parent_hash":       {"type": "hash", "nullable": true},
    "workload_id":       {"type": "str"},
    "operator":          {"type": "str"},
    "source_sha256":     {"type": "hash"},
    "input_sha256":      {"type": "hash", "nullable": true},
    "artifact_sha256":   {"type": "hash"},
    "profile":           {"type": "str"},
    "config_hash":       {"type": "hash"},
    "opt_level":         {"type": "int", "enum": [0, 1, 2]},
    "evidence_level":    {"type": "str", "enum": ["predicted", "measured-rtl"]},
    "status":            {"type": "str", "enum": ["pass", "compile-failure", "runtime-fault", "numeric-error", "capacity-exceeded", "timeout", "not-measured", "unsupported"]},
    "correctness.detail":            {"type": "str"},
    "time.roi":                      {"type": "str", "enum": ["launch_accept_to_core_idle"]},
    "time.timing":                   {"type": "str", "enum": ["serial-grid", "device-makespan"]},
    "time.device_cycles":            {"type": "int", "nullable": true, "positive_or_null": true, "unit": "cycles"},
    "time.program_cycles":           {"type": "list", "nullable": true, "unit": "cycles"},
    "time.host_seconds":             {"type": "float", "nullable": true, "positive_or_null": true, "unit": "s"},
    "time.achieved_clock_hz":        {"type": "float", "nullable": true, "stage1_null": true, "unit": "Hz"},
    "time.device_seconds":           {"type": "float", "nullable": true, "stage1_null": true, "unit": "s"},
    "counters":                      {"type": "object", "nullable": true},
    "traffic.required_lower_bound_bytes": {"type": "float", "nullable": true, "unit": "bytes"},
    "traffic.measured_bytes":        {"type": "int", "nullable": true, "unit": "bytes"},
    "bounds.version":                {"type": "str"},
    "bounds.strict_cycles":          {"type": "float", "nullable": true, "positive_or_null": true, "unit": "cycles"},
    "bounds.scoped_cycles":          {"type": "float", "nullable": true, "positive_or_null": true, "unit": "cycles"},
    "bounds.binding":                {"type": "str", "nullable": true},
    "bounds.eta":                    {"type": "float", "nullable": true},
    "resources.lut":                 {"type": "int", "nullable": true, "stage1_null": true},
    "resources.ff":                  {"type": "int", "nullable": true, "stage1_null": true},
    "resources.dsp":                 {"type": "int", "nullable": true, "stage1_null": true},
    "resources.bram":                {"type": "int", "nullable": true, "stage1_null": true},
    "resources.power_w":             {"type": "float", "nullable": true, "stage1_null": true, "unit": "W"},
    "repeat.seed":                   {"type": "int"},
    "repeat.index":                  {"type": "int"}
  },
  "rules": [
    "status pass requires time.device_cycles and evidence_level measured-rtl (or predicted with no device time)",
    "bounds.eta is bounds.strict_cycles / time.device_cycles and never exceeds 1"
  ]
}
