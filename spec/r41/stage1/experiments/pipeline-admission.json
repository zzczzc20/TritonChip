{
  "schema": "tnca-experiment-spec/1",
  "id": "r41-ring-stage-and-engine-admission-screen",
  "allowed_hosts": [
    "gx10-6646"
  ],
  "hypothesis": "Additional legal ring stages can be limited by shared DMA admission and home service; actual DMA/MMA overlap must be distinguished from model performance benefit.",
  "competing_explanations": [
    "a requested ring is never executed",
    "input values or placements change between candidates",
    "matrix/transfer commands are silently serialized",
    "accumulator moves are counted as useful MMA overlap",
    "a model ranking is promoted to a board win"
  ],
  "expected_observations": [
    "standard Torch mm/addmm execute the requested ring on tails and exact tiles",
    "actual input hashes and bindings are retained",
    "model DMA/matrix/home/outlet counters expose admission pressure",
    "RTL records real transfer and op1-MMA intervals",
    "negative or uncertain model results retain legal candidates and defaults"
  ],
  "sources": [
    "tools/performance_harness/fragment_case.py",
    "tools/performance_harness/pipeline_admission_compare.py",
    "tools/performance_harness/experiment.py",
    "tools/performance_harness/systemc",
    "tools/r40/engine_overlap.py",
    "python/tnca",
    "compiler/python",
    "compiler/targets",
    "tools/asm",
    "tools/model",
    "rtl",
    "tb",
    "isa",
    "spec/r41/stage1/experiments/pipeline-admission.json"
  ],
  "env": {
    "PATH": "{home}/tc_env/bin:/usr/local/bin:/usr/bin:/bin",
    "PYTHONPATH": "{root}:{root}/python:{root}/compiler/python:{root}/tools/asm:{root}/tools/performance_harness/systemc",
    "OMP_NUM_THREADS": "2",
    "MKL_NUM_THREADS": "2",
    "TNCA_BACKEND": "systemc-tlm-grid",
    "TNCA_TLM_BINARY": "{home}/r41-stage1/runs/harness-smoke-v6/model-build/tnca-chip",
    "TNCA_TLM_CONFIG": "{root}/tools/performance_harness/systemc/configs/r40-board-m2.cfg",
    "TNCA_TLM_MEMORY_BYTES": "16777216",
    "TNCA_HOST_TIMEOUT": "300",
    "TNCA_DEADLINE": "200000000",
    "TNCA_TENSOR_DESCRIPTORS": "1",
    "TNCA_TORCH_DEVICE": "native",
    "TNCA_PROFILE": "core-vrf-sync-v5",
    "TNCA_RCTX_ROLES": "0",
    "TNCA_RCTX_STAGES": "2",
    "TNCA_TUNE": "0"
  },
  "steps": [
    {
      "id": "model-baseline",
      "kind": "systemc",
      "argv": [
        "{python}",
        "tools/performance_harness/fragment_case.py",
        "--columns",
        "16",
        "--shapes",
        "16x16x48,17x31x65",
        "--out",
        "{out}/model-baseline"
      ],
      "timeout_seconds": 600,
      "env": {
        "TNCA_DRAM_MAP": "{home}/r41-stage1/runs/physical-dram-map-v2/map/map.txt",
        "TNCA_ACTIVE_CORES": "1"
      },
      "inputs": [
        "{home}/r41-stage1/runs/harness-smoke-v6/model-build/tnca-chip",
        "{home}/r41-stage1/runs/physical-dram-map-v2/map/map.txt"
      ],
      "outputs": [
        "{out}/model-baseline/report.json"
      ]
    },
    {
      "id": "model-stage1",
      "kind": "systemc",
      "argv": [
        "{python}",
        "tools/performance_harness/fragment_case.py",
        "--columns",
        "16",
        "--shapes",
        "16x16x48,17x31x65",
        "--ring-stages",
        "1",
        "--out",
        "{out}/model-stage1"
      ],
      "timeout_seconds": 600,
      "env": {
        "TNCA_DRAM_MAP": "{home}/r41-stage1/runs/physical-dram-map-v2/map/map.txt",
        "TNCA_ACTIVE_CORES": "1"
      },
      "inputs": [
        "{home}/r41-stage1/runs/harness-smoke-v6/model-build/tnca-chip",
        "{home}/r41-stage1/runs/physical-dram-map-v2/map/map.txt"
      ],
      "outputs": [
        "{out}/model-stage1/report.json"
      ]
    },
    {
      "id": "model-stage2",
      "kind": "systemc",
      "argv": [
        "{python}",
        "tools/performance_harness/fragment_case.py",
        "--columns",
        "16",
        "--shapes",
        "16x16x48,17x31x65",
        "--ring-stages",
        "2",
        "--out",
        "{out}/model-stage2"
      ],
      "timeout_seconds": 600,
      "env": {
        "TNCA_DRAM_MAP": "{home}/r41-stage1/runs/physical-dram-map-v2/map/map.txt",
        "TNCA_ACTIVE_CORES": "1"
      },
      "inputs": [
        "{home}/r41-stage1/runs/harness-smoke-v6/model-build/tnca-chip",
        "{home}/r41-stage1/runs/physical-dram-map-v2/map/map.txt"
      ],
      "outputs": [
        "{out}/model-stage2/report.json"
      ]
    },
    {
      "id": "model-stage3",
      "kind": "systemc",
      "argv": [
        "{python}",
        "tools/performance_harness/fragment_case.py",
        "--columns",
        "16",
        "--shapes",
        "16x16x48,17x31x65",
        "--ring-stages",
        "3",
        "--out",
        "{out}/model-stage3"
      ],
      "timeout_seconds": 600,
      "env": {
        "TNCA_DRAM_MAP": "{home}/r41-stage1/runs/physical-dram-map-v2/map/map.txt",
        "TNCA_ACTIVE_CORES": "1"
      },
      "inputs": [
        "{home}/r41-stage1/runs/harness-smoke-v6/model-build/tnca-chip",
        "{home}/r41-stage1/runs/physical-dram-map-v2/map/map.txt"
      ],
      "outputs": [
        "{out}/model-stage3/report.json"
      ]
    },
    {
      "id": "rtl-stage1",
      "kind": "rtl",
      "argv": [
        "{python}",
        "tools/performance_harness/fragment_case.py",
        "--columns",
        "16",
        "--shapes",
        "16x16x48,17x31x65",
        "--ring-stages",
        "1",
        "--rtl-engine-trace",
        "--out",
        "{out}/rtl-stage1"
      ],
      "timeout_seconds": 900,
      "env": {
        "TNCA_BACKEND": "sim-file"
      },
      "outputs": [
        "{out}/rtl-stage1/report.json",
        "{out}/rtl-stage1/rtl-engine.log"
      ]
    },
    {
      "id": "rtl-stage2",
      "kind": "rtl",
      "argv": [
        "{python}",
        "tools/performance_harness/fragment_case.py",
        "--columns",
        "16",
        "--shapes",
        "16x16x48,17x31x65",
        "--ring-stages",
        "2",
        "--rtl-engine-trace",
        "--out",
        "{out}/rtl-stage2"
      ],
      "timeout_seconds": 900,
      "env": {
        "TNCA_BACKEND": "sim-file"
      },
      "outputs": [
        "{out}/rtl-stage2/report.json",
        "{out}/rtl-stage2/rtl-engine.log"
      ]
    },
    {
      "id": "rtl-stage3",
      "kind": "rtl",
      "argv": [
        "{python}",
        "tools/performance_harness/fragment_case.py",
        "--columns",
        "16",
        "--shapes",
        "16x16x48,17x31x65",
        "--ring-stages",
        "3",
        "--rtl-engine-trace",
        "--out",
        "{out}/rtl-stage3"
      ],
      "timeout_seconds": 900,
      "env": {
        "TNCA_BACKEND": "sim-file"
      },
      "outputs": [
        "{out}/rtl-stage3/report.json",
        "{out}/rtl-stage3/rtl-engine.log"
      ]
    },
    {
      "id": "compare",
      "kind": "compare",
      "argv": [
        "{python}",
        "tools/performance_harness/pipeline_admission_compare.py",
        "--case",
        "model-baseline={out}/model-baseline/report.json",
        "--case",
        "model-stage1={out}/model-stage1/report.json",
        "--case",
        "model-stage2={out}/model-stage2/report.json",
        "--case",
        "model-stage3={out}/model-stage3/report.json",
        "--case",
        "rtl-stage1={out}/rtl-stage1/report.json",
        "--case",
        "rtl-stage2={out}/rtl-stage2/report.json",
        "--case",
        "rtl-stage3={out}/rtl-stage3/report.json",
        "--out",
        "{out}/comparison.json"
      ],
      "timeout_seconds": 30,
      "inputs": [
        "{out}/model-baseline/report.json",
        "{out}/model-stage1/report.json",
        "{out}/model-stage2/report.json",
        "{out}/model-stage3/report.json",
        "{out}/rtl-stage1/report.json",
        "{out}/rtl-stage2/report.json",
        "{out}/rtl-stage3/report.json"
      ],
      "outputs": [
        "{out}/comparison.json"
      ]
    }
  ]
}
