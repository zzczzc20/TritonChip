  "schema": "tnca-experiment-spec/1",
  "id": "board-gemm-tile",
  "allowed_hosts": [
    "acf3019"
  ],
  "hypothesis": "With the Stage 1 multi-fragment lowering, TNCA_GEMM_TILE=16,32,16 keeps two resident 16x16 accumulators across K and is no slower than the conservative 16,16,16 product path on the R40-03 GEMM subset, unlike R40 where the old lowering made it up to ~4.7x slower.",
  "competing_explanations": [
    "16,32,16 silently falls back to 16,16,16 (identical artifacts)",
    "gains come from changed placement or launch count rather than accumulator residency",
    "HBM-bound GEMV/linear points are limited by memory service, not accumulator traffic",
    "the R40 B40-S configuration (one core, per-kernel transfers) hides multi-core effects"
  ],
  "expected_counter_changes": [
    "ACC row read/write/zero commands per K step drop to epilogue-only for 16,32,16",
    "MMA commands per K step double per fragment pair; instruction count no longer ~12x the 16x16 path",
    "device cycles of 16,32,16 <= 16,16,16 on compute-bound points; neutral on memory-bound points"
  ],
  "expected_observations": [
    "9 points x {16,16,16; 16,32,16} pass numerically; formal samples per the registered rule",
    "old-mapping comparison uses the fe1b campaign records of the same keys; conservative baseline is the 16,16,16 arm"
  ],
