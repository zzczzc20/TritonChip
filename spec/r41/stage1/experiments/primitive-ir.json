{
  "schema": "tnca-experiment-spec/1",
  "id": "r41-representative-primitive-ir-and-memory",
  "allowed_hosts": ["gx10-6646"],
  "hypothesis": "Representative D256 attention, depthwise convolution and FP32 recurrence retain actual compiler-stage IR, legal resource plans and bounded native memory while preserving their independent references.",
  "competing_explanations": ["cache hits hide compilation", "same-name kernels overwrite distinct IR", "only analytical memory is reported", "a state dtype is narrowed", "a numerical host fallback or implicit tensor staging executes"],
  "expected_observations": ["each fresh process retains TTIR, TNIR, assembly and machine image", "distinct compilation content has distinct dump directories", "actual Session heap/code peaks and backend lowering times are recorded", "all native outputs match independent CPU references"],
  "sources": ["python/tnca", "compiler/python", "compiler/targets", "tools/asm", "isa", "tools/performance_harness/primitive_cases.py", "tools/performance_harness/experiment.py", "tools/performance_harness/systemc", "spec/r41/stage1/experiments/primitive-ir.json"],
  "env": {
    "PATH": "{home}/tc_env/bin:/usr/local/bin:/usr/bin:/bin",
    "PYTHONPATH": "{root}:{root}/python:{root}/compiler/python:{root}/tools/asm:{root}/tools/performance_harness/systemc",
    "OMP_NUM_THREADS": "2", "MKL_NUM_THREADS": "2",
    "TNCA_BACKEND": "systemc-tlm-grid",
    "TNCA_TLM_BINARY": "{home}/r41-stage1/runs/dram-guards-v1/build/tnca-chip",
    "TNCA_TLM_CONFIG": "{root}/tools/performance_harness/systemc/configs/r40-board-m2.cfg",
    "TNCA_TLM_MEMORY_BYTES": "16777216", "TNCA_HOST_TIMEOUT": "300", "TNCA_DEADLINE": "200000000",
    "TNCA_TENSOR_DESCRIPTORS": "1", "TNCA_TORCH_DEVICE": "native", "TNCA_PROFILE": "core-vrf-sync-v5"
  },
  "steps": [
    {"id": "attention", "kind": "systemc", "argv": ["{python}", "tools/performance_harness/primitive_cases.py", "--only", "attention", "--out", "{out}/attention"], "timeout_seconds": 600, "inputs": ["{home}/r41-stage1/runs/dram-guards-v1/build/tnca-chip"], "outputs": ["{out}/attention/report.json"]},
    {"id": "depthwise", "kind": "systemc", "argv": ["{python}", "tools/performance_harness/primitive_cases.py", "--only", "depthwise", "--out", "{out}/depthwise"], "timeout_seconds": 600, "inputs": ["{home}/r41-stage1/runs/dram-guards-v1/build/tnca-chip"], "outputs": ["{out}/depthwise/report.json"]},
    {"id": "recurrence", "kind": "systemc", "argv": ["{python}", "tools/performance_harness/primitive_cases.py", "--only", "recurrence", "--out", "{out}/recurrence"], "timeout_seconds": 600, "inputs": ["{home}/r41-stage1/runs/dram-guards-v1/build/tnca-chip"], "outputs": ["{out}/recurrence/report.json"]}
  ]
}
