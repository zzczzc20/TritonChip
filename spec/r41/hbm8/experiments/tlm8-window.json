{
  "schema": "tnca-experiment-spec/1",
  "id": "r41-tlm-8gib-device-window",
  "allowed_hosts": ["gx10-6646"],
  "hypothesis": "With an explicit 8 GiB BO over PC0-PC31 (a PLANNED map, extrapolated from the recorded 4 GiB B40 allocation), the native model executes standard Torch graphs whose storages lie above 4 GiB, near the BO top, across the PC15/PC16 boundary and over 2 GiB, identically on the fast and slow DRAM paths, with PC16-PC31 traffic and explicit refusals at the BO top and the TMU page.",
  "competing_explanations": ["the legacy contiguous logical PC check silently caps the mapped window at 8 GiB minus the local region", "addresses above 4 GiB alias lower PCs", "a host transfer over 2 GiB is truncated by one write(2)", "the slow path drops or misnumbers PCs above 15", "the planned map is mistaken for a recorded allocation", "host memory grows with the window size rather than the touched footprint"],
  "expected_observations": ["the recorded 4 GiB map is reproduced byte-for-byte; the planned map is marked planned", "the unmodified model refuses the mapped 8 GiB window; the modified one accepts it and refuses one line more", "every Torch output matches its CPU reference on both paths", "per-PC counters equal the independent translation (native) and show PC16-PC31 traffic (Torch)", "model RSS tracks touched bytes, not the 8 GiB window"],
  "sources": ["tools/performance_harness/systemc", "tools/performance_harness/hbm8_window_case.py", "tools/performance_harness/fragment_case.py", "tools/performance_harness/experiment.py", "python/tnca", "compiler/python", "compiler/targets", "tools/asm", "isa", "xls/tnca_sfu_tables.x", "evidence/r40/v3/R40-04.hbm/board_run_fe1b/window_samples.json", "spec/r41/hbm8/experiments/tlm8-window.json"],
  "env": {
    "PATH": "{home}/tc_env/bin:/usr/local/bin:/usr/bin:/bin",
    "PYTHONPATH": "{root}:{root}/python:{root}/compiler/python:{root}/tools/asm:{root}/tools/performance_harness/systemc",
    "OMP_NUM_THREADS": "2",
    "MKL_NUM_THREADS": "2",
    "TORCHINDUCTOR_COMPILE_THREADS": "1",
    "TNCA_BACKEND": "systemc-tlm-grid",
    "TNCA_TLM_BINARY": "{out}/build/tnca-chip",
    "TNCA_TLM_CONFIG": "{root}/tools/performance_harness/systemc/configs/r40-board-m2.cfg",
    "TNCA_TLM_MEMORY_BYTES": "8590065664",
    "TNCA_DRAM_MAP": "{out}/map8/map.txt",
    "TNCA_HOST_TIMEOUT": "86400",
    "TNCA_DEADLINE": "1000000000000",
    "TNCA_ACTIVE_CORES": "3",
    "TNCA_TENSOR_DESCRIPTORS": "1",
    "TNCA_TORCH_DEVICE": "native",
    "TNCA_PROFILE": "core-vrf-sync-v5"
  },
  "steps": [
    {"id": "map-unit-tests", "kind": "compile", "argv": ["{python}", "tools/performance_harness/systemc/test_dram_address_map.py", "-v"], "timeout_seconds": 30},
    {"id": "recorded-4gib-map", "kind": "analytical", "argv": ["{python}", "tools/performance_harness/systemc/dram_address_map.py", "--source", "evidence/r40/v3/R40-04.hbm/board_run_fe1b/window_samples.json", "--window-pointer", "/results/0/detail", "--image-pointer", "/identity/image_sha256", "--image-sha256", "a88ebdf59cfbbb2001ebd5b1b2c739c5d8cd33931f1e9202f18cac07c4c83083", "--out", "{out}/map4"], "timeout_seconds": 30, "outputs": ["{out}/map4/report.json", "{out}/map4/map.txt"]},
    {"id": "planned-8gib-map", "kind": "analytical", "argv": ["{python}", "tools/performance_harness/systemc/dram_address_map.py", "--source", "evidence/r40/v3/R40-04.hbm/board_run_fe1b/window_samples.json", "--window-pointer", "/results/0/detail", "--image-pointer", "/identity/image_sha256", "--image-sha256", "a88ebdf59cfbbb2001ebd5b1b2c739c5d8cd33931f1e9202f18cac07c4c83083", "--plan-bo-bytes", "8589934592", "--out", "{out}/map8"], "timeout_seconds": 30, "outputs": ["{out}/map8/report.json", "{out}/map8/map.txt"]},
    {"id": "configure", "kind": "compile", "argv": ["cmake", "-S", "tools/performance_harness/systemc", "-B", "{out}/build", "-DCMAKE_BUILD_TYPE=Release", "-DCMAKE_PREFIX_PATH={home}/tc_env/systemc-3.0.2/install", "-DRAMULATOR2_DIR={home}/tc_env/ramulator2"], "timeout_seconds": 120},
    {"id": "build", "kind": "compile", "argv": ["cmake", "--build", "{out}/build", "-j", "4"], "timeout_seconds": 900, "outputs": ["{out}/build/tnca-chip", "{out}/build/tnca-dram-path-test"]},
    {"id": "native-mapper-boundaries", "kind": "systemc", "argv": ["{out}/build/tnca-dram-path-test", "{root}/tools/performance_harness/systemc/configs/r40-board-m2.cfg"], "timeout_seconds": 30, "inputs": ["{out}/build/tnca-dram-path-test"]},
    {"id": "native-8gib-window", "kind": "systemc", "argv": ["{python}", "tools/performance_harness/systemc/test_hbm8_native.py", "--binary", "{out}/build/tnca-chip", "--baseline-binary", "{home}/r41-tlm8-build/base/tnca-chip", "--config", "{root}/tools/performance_harness/systemc/configs/r40-board-m2.cfg", "--map", "{out}/map8/map.txt", "--audit", "{out}/map8/report.json", "--out", "{out}/native"], "timeout_seconds": 1200, "inputs": ["{out}/build/tnca-chip", "{home}/r41-tlm8-build/base/tnca-chip", "{out}/map8/map.txt"], "outputs": ["{out}/native/report.json"]},
    {"id": "torch-placement-fast", "kind": "systemc", "argv": ["{python}", "tools/performance_harness/hbm8_window_case.py", "--case", "placement", "--map-audit", "{out}/map8/report.json", "--out", "{out}/torch/placement-fast"], "timeout_seconds": 1800, "env": {"TNCA_DRAM_PATH": "fast"}, "inputs": ["{out}/build/tnca-chip", "{out}/map8/map.txt"], "outputs": ["{out}/torch/placement-fast/report.json"]},
    {"id": "torch-placement-slow", "kind": "systemc", "argv": ["{python}", "tools/performance_harness/hbm8_window_case.py", "--case", "placement", "--map-audit", "{out}/map8/report.json", "--out", "{out}/torch/placement-slow"], "timeout_seconds": 3600, "env": {"TNCA_DRAM_PATH": "slow"}, "inputs": ["{out}/build/tnca-chip", "{out}/map8/map.txt"], "outputs": ["{out}/torch/placement-slow/report.json"]},
    {"id": "torch-crossing-fast", "kind": "systemc", "argv": ["{python}", "tools/performance_harness/hbm8_window_case.py", "--case", "crossing", "--map-audit", "{out}/map8/report.json", "--out", "{out}/torch/crossing-fast"], "timeout_seconds": 1800, "env": {"TNCA_DRAM_PATH": "fast"}, "inputs": ["{out}/build/tnca-chip", "{out}/map8/map.txt"], "outputs": ["{out}/torch/crossing-fast/report.json"]},
    {"id": "torch-crossing-slow", "kind": "systemc", "argv": ["{python}", "tools/performance_harness/hbm8_window_case.py", "--case", "crossing", "--map-audit", "{out}/map8/report.json", "--out", "{out}/torch/crossing-slow"], "timeout_seconds": 3600, "env": {"TNCA_DRAM_PATH": "slow"}, "inputs": ["{out}/build/tnca-chip", "{out}/map8/map.txt"], "outputs": ["{out}/torch/crossing-slow/report.json"]},
    {"id": "torch-gemm-fast", "kind": "systemc", "argv": ["{python}", "tools/performance_harness/hbm8_window_case.py", "--case", "gemm", "--map-audit", "{out}/map8/report.json", "--out", "{out}/torch/gemm-fast"], "timeout_seconds": 1800, "env": {"TNCA_DRAM_PATH": "fast"}, "inputs": ["{out}/build/tnca-chip", "{out}/map8/map.txt"], "outputs": ["{out}/torch/gemm-fast/report.json"]},
    {"id": "torch-gemm-slow", "kind": "systemc", "argv": ["{python}", "tools/performance_harness/hbm8_window_case.py", "--case", "gemm", "--map-audit", "{out}/map8/report.json", "--out", "{out}/torch/gemm-slow"], "timeout_seconds": 3600, "env": {"TNCA_DRAM_PATH": "slow"}, "inputs": ["{out}/build/tnca-chip", "{out}/map8/map.txt"], "outputs": ["{out}/torch/gemm-slow/report.json"]},
    {"id": "torch-refusal-fast", "kind": "systemc", "argv": ["{python}", "tools/performance_harness/hbm8_window_case.py", "--case", "refusal", "--map-audit", "{out}/map8/report.json", "--out", "{out}/torch/refusal-fast"], "timeout_seconds": 1800, "env": {"TNCA_DRAM_PATH": "fast"}, "inputs": ["{out}/build/tnca-chip", "{out}/map8/map.txt"], "outputs": ["{out}/torch/refusal-fast/report.json"]},
    {"id": "torch-refusal-slow", "kind": "systemc", "argv": ["{python}", "tools/performance_harness/hbm8_window_case.py", "--case", "refusal", "--map-audit", "{out}/map8/report.json", "--out", "{out}/torch/refusal-slow"], "timeout_seconds": 3600, "env": {"TNCA_DRAM_PATH": "slow"}, "inputs": ["{out}/build/tnca-chip", "{out}/map8/map.txt"], "outputs": ["{out}/torch/refusal-slow/report.json"]},
    {"id": "torch-stream-64mib-fast", "kind": "systemc", "argv": ["{python}", "tools/performance_harness/hbm8_window_case.py", "--case", "stream", "--stream-bytes", "67108864", "--map-audit", "{out}/map8/report.json", "--out", "{out}/torch/stream-64mib-fast"], "timeout_seconds": 7200, "env": {"TNCA_DRAM_PATH": "fast"}, "inputs": ["{out}/build/tnca-chip", "{out}/map8/map.txt"], "outputs": ["{out}/torch/stream-64mib-fast/report.json"]},
    {"id": "torch-stream-64mib-slow", "kind": "systemc", "argv": ["{python}", "tools/performance_harness/hbm8_window_case.py", "--case", "stream", "--stream-bytes", "67108864", "--map-audit", "{out}/map8/report.json", "--out", "{out}/torch/stream-64mib-slow"], "timeout_seconds": 7200, "env": {"TNCA_DRAM_PATH": "slow"}, "inputs": ["{out}/build/tnca-chip", "{out}/map8/map.txt"], "outputs": ["{out}/torch/stream-64mib-slow/report.json"]},
    {"id": "torch-stream-256mib-fast", "kind": "systemc", "argv": ["{python}", "tools/performance_harness/hbm8_window_case.py", "--case", "stream", "--stream-bytes", "268435456", "--map-audit", "{out}/map8/report.json", "--out", "{out}/torch/stream-256mib-fast"], "timeout_seconds": 7200, "env": {"TNCA_DRAM_PATH": "fast"}, "inputs": ["{out}/build/tnca-chip", "{out}/map8/map.txt"], "outputs": ["{out}/torch/stream-256mib-fast/report.json"]},
    {"id": "torch-stream-256mib-slow", "kind": "systemc", "argv": ["{python}", "tools/performance_harness/hbm8_window_case.py", "--case", "stream", "--stream-bytes", "268435456", "--map-audit", "{out}/map8/report.json", "--out", "{out}/torch/stream-256mib-slow"], "timeout_seconds": 7200, "env": {"TNCA_DRAM_PATH": "slow"}, "inputs": ["{out}/build/tnca-chip", "{out}/map8/map.txt"], "outputs": ["{out}/torch/stream-256mib-slow/report.json"]},
    {"id": "torch-stream-1024mib-fast", "kind": "systemc", "argv": ["{python}", "tools/performance_harness/hbm8_window_case.py", "--case", "stream", "--stream-bytes", "1073741824", "--map-audit", "{out}/map8/report.json", "--out", "{out}/torch/stream-1024mib-fast"], "timeout_seconds": 7200, "env": {"TNCA_DRAM_PATH": "fast"}, "inputs": ["{out}/build/tnca-chip", "{out}/map8/map.txt"], "outputs": ["{out}/torch/stream-1024mib-fast/report.json"]},
    {"id": "torch-stream-1024mib-slow", "kind": "systemc", "argv": ["{python}", "tools/performance_harness/hbm8_window_case.py", "--case", "stream", "--stream-bytes", "1073741824", "--map-audit", "{out}/map8/report.json", "--out", "{out}/torch/stream-1024mib-slow"], "timeout_seconds": 7200, "env": {"TNCA_DRAM_PATH": "slow"}, "inputs": ["{out}/build/tnca-chip", "{out}/map8/map.txt"], "outputs": ["{out}/torch/stream-1024mib-slow/report.json"]},
    {"id": "torch-stream-2gib-fast", "kind": "systemc", "argv": ["{python}", "tools/performance_harness/hbm8_window_case.py", "--case", "stream", "--stream-bytes", "2214592512", "--map-audit", "{out}/map8/report.json", "--out", "{out}/torch/stream-2gib-fast"], "timeout_seconds": 7200, "env": {"TNCA_DRAM_PATH": "fast"}, "inputs": ["{out}/build/tnca-chip", "{out}/map8/map.txt"], "outputs": ["{out}/torch/stream-2gib-fast/report.json"]},
    {"id": "torch-stream-2gib-slow", "kind": "systemc", "argv": ["{python}", "tools/performance_harness/hbm8_window_case.py", "--case", "stream", "--stream-bytes", "2214592512", "--map-audit", "{out}/map8/report.json", "--out", "{out}/torch/stream-2gib-slow"], "timeout_seconds": 21600, "env": {"TNCA_DRAM_PATH": "slow"}, "inputs": ["{out}/build/tnca-chip", "{out}/map8/map.txt"], "outputs": ["{out}/torch/stream-2gib-slow/report.json"]}
  ]
}
