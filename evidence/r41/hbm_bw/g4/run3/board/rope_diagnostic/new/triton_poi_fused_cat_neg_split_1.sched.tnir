tnca.kernel @triton_poi_fused_cat_neg_split_1 {
  // no shared resources, no bound arguments

  role 0 @role0 {
    %rctx_chunk_lane:scalar = tnca.special()  {name='role_id'}
    %rctx_chunk_start:scalar = tnca.program_id()  {dim=0}
    %rctx_programs:scalar = tnca.num_programs()  {dim=0}
    %pid5:scalar = tnca.sbin(%rctx_chunk_start:scalar, %rctx_chunk_lane:scalar)  {op='add'}
    %rctx_chunk_outside:scalar = tnca.scmp(%pid5:scalar, %rctx_programs:scalar)  {cc='ge'}
    tnca.branch_nz(%rctx_chunk_outside:scalar)  {target='__rctx_next'}
  ^__rctx_program:
    %s7:scalar = tnca.sbini(%pid5:scalar)  {imm=4 op='shl'}   // x16 as a shift
    %ar8:vector = tnca.arange()
    %sp9:vector = tnca.splat(%s7:scalar)
    %k26:vector = tnca.vmovi()  {imm=0}
    %k14:vector = tnca.vmovi()  {imm=0}
    %v10:vector = tnca.vbin(%sp9:vector, %ar8:vector)  {fmm=None op='add'}
    %k34:vector = tnca.vmovi()  {imm=3}
    %k22:vector = tnca.vmovi()  {imm=7}
    %v30:vector = tnca.vbin(%k26:vector, %v10:vector)  {fmm=None op='sub'}
    %m28:pred = tnca.vcmp(%v10:vector, %k26:vector)  {cc='lt'}
    %v18:vector = tnca.vbin(%k14:vector, %v10:vector)  {fmm=None op='sub'}
    %v31:vector = tnca.vselect(%m28:pred, %v30:vector, %v10:vector)
    %m16:pred = tnca.vcmp(%v10:vector, %k14:vector)  {cc='lt'}
    %v19:vector = tnca.vselect(%m16:pred, %v18:vector, %v10:vector)
    %v35:vector = tnca.vbin(%v31:vector, %k34:vector)  {fmm=None op='lshr'}
    %sp1:scalar = tnca.special()  {name='arg_base'}
    %v23:vector = tnca.vbin(%v19:vector, %k22:vector)  {fmm=None op='and'}
    %v36:vector = tnca.vbin(%k26:vector, %v35:vector)  {fmm=None op='sub'}
    %m2:scalar = tnca.sload(%sp1:scalar)  {offset=0 size='d'}   // in_ptr0: device_ptr64 at arg_base+0
    %v24:vector = tnca.vbin(%k14:vector, %v23:vector)  {fmm=None op='sub'}
    %v37:vector = tnca.vselect(%m28:pred, %v36:vector, %v35:vector)
    %k38:vector = tnca.vmovi()  {imm=16}
    %v25:vector = tnca.vselect(%m16:pred, %v24:vector, %v23:vector)
    %k11:vector = tnca.vmovi()  {imm=256}
    %v39:vector = tnca.vbin(%v37:vector, %k38:vector)  {fmm=None op='mul'}
    %k13:vector = tnca.vmovi()  {imm=8}
    %m12:pred = tnca.vcmp(%v10:vector, %k11:vector)  {cc='lt'}
    %v40:vector = tnca.vbin(%v25:vector, %v39:vector)  {fmm=None op='add'}
    %v20:vector = tnca.vbin(%k14:vector, %k13:vector)  {fmm=None op='sub'}
    %m3:scalar = tnca.sload(%sp1:scalar)  {offset=8 size='d'}   // out_ptr0: device_ptr64 at arg_base+8
    %v32:vector = tnca.vbin(%k26:vector, %k13:vector)  {fmm=None op='sub'}
    %m17:pred = tnca.vcmp(%k13:vector, %k14:vector)  {cc='lt'}
    %m29:pred = tnca.vcmp(%k13:vector, %k26:vector)  {cc='lt'}
    %v21:vector = tnca.vselect(%m17:pred, %v20:vector, %k13:vector)
    %v33:vector = tnca.vselect(%m29:pred, %v32:vector, %k13:vector)
    %g41:vector = tnca.gather(%m2:scalar, %v40:vector)  {mask=%m12:pred other=0 size='h'}
    tnca.scatter(%m3:scalar, %v40:vector, %g41:vector)  {mask=%m12:pred size='h'}
  ^__rctx_next:
    tnca.exit()
  }
}
