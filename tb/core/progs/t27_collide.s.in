// t27_collide -- two engine completions on one barrier in the same cycle.
//
// R1-08 REG-10: "DMA/MMA 同周期完成均被计数". rtl/core/tnca_barrier.v sums
// three independent completion ports precisely so that a shared one cannot
// drop whichever loses the mux -- and across every program in the suite that
// case had never once occurred. A mechanism no test has exercised is a
// mechanism nobody has tested, whatever the code says.
//
// So this arranges it. The matrix unit's command takes about 224 cycles and
// the transfer about 72, both counted on b0, so issuing the MMA first and the
// transfer some cycles later makes them land together. The delay is not
// hard-coded: tools/r1/regression.py measures the two latencies from a
// +donetrace run, solves for the crossing and sweeps around it, because a
// constant here would silently stop colliding the first time either engine's
// timing changed.
//
// The transfer targets w2 -- registers neither fragment uses -- so the
// program is one the compiler's own ownership rules would also accept.
.org 0
start:
    w.def     w0, #32, #8
    w.def     w1, #40, #8
    w.def     w2, #48, #8
    .li       s1, #24576
    td.load   d0, [s1]
    .li       s2, #24832
    td.load   d1, [s2]

    // fill both fragments first, so the collision experiment below starts
    // from a known state
    mb.init   b0
    mb.arm    s3, b0, #0, #2
    .li       s10, #0
    .li       s11, #0
    t.ld.async.h w0, d0, s10, s3
    t.ld.async.h w1, d1, s10, s3
    mb.wait   s3

    // one barrier, two operations, two different engines
    m.zero    a0
    mb.arm    s4, b0, #0, #2
    m.mma.async a0, v32, v40, s4
@DELAY@
    t.ld.async.h w2, d0, s10, s4
    // If either completion were dropped this wait never returns and the run
    // times out. Reaching `exit` is the check.
    mb.wait   s4
    exit

.org 0x4000
