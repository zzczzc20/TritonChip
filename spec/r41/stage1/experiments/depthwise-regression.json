{
  "schema": "tnca-experiment-spec/1",
  "id": "r41-depthwise-broadcast-and-resources",
  "allowed_hosts": ["gx10-6646"],
  "hypothesis": "Generic singleton-column broadcast and bounded pointwise resource retiles preserve all lanes and convolution geometries on the native execution path.",
  "competing_explanations": [
    "only lane zero receives the loaded bias",
    "predicate masks lose lane bits under register pressure",
    "smaller pointwise blocks change stride or dilation semantics",
    "the new passes damage resident wide MMA accumulators"
  ],
  "expected_observations": [
    "predicate scalar masks match every RTL output lane",
    "FP16, BF16 and FP32 column broadcasts and depthwise cases match independent CPU references without fallback",
    "wide K-loop accumulators remain resident",
    "D256 attention, depthwise convolution and FP32 recurrent state execute through standard Torch"
  ],
  "sources": [
    "compiler/python", "compiler/targets", "compiler/test",
    "python/tnca", "tools/asm", "tools/model", "isa",
    "tools/performance_harness/test_depthwise.py",
    "tools/performance_harness/primitive_cases.py",
    "tools/performance_harness/experiment.py",
    "tools/performance_harness/systemc/tlm_backend.py",
    "spec/r41/stage1/experiments/depthwise-regression.json"
  ],
  "env": {
    "PATH": "{home}/tc_env/bin:/usr/local/bin:/usr/bin:/bin",
    "PYTHONPATH": "{root}:{root}/python:{root}/compiler/python:{root}/compiler/test:{root}/tools/asm:{root}/tools/performance_harness/systemc",
    "OMP_NUM_THREADS": "2", "MKL_NUM_THREADS": "2",
    "TNCA_BACKEND": "systemc-tlm-grid",
    "TNCA_TLM_BINARY": "{home}/r41-stage1/runs/harness-smoke-v3/model-build/tnca-chip",
    "TNCA_TLM_CONFIG": "{root}/tools/performance_harness/systemc/configs/r40-board-m2.cfg",
    "TNCA_TLM_MEMORY_BYTES": "16777216",
    "TNCA_HOST_TIMEOUT": "600", "TNCA_DEADLINE": "200000000",
    "TNCA_TENSOR_DESCRIPTORS": "1", "TNCA_TORCH_DEVICE": "native",
    "TNCA_PROFILE": "core-vrf-sync-v5",
    "TRITON_CACHE_DIR": "{out}/triton-cache",
    "TORCHINDUCTOR_CACHE_DIR": "{out}/inductor-cache"
  },
  "steps": [
    {
      "id": "predicate-lane-rtl", "kind": "rtl",
      "argv": ["{python}", "compiler/test/test_predicate_spill.py", "-v"],
      "inputs": ["{root}/sim/build/tb_core.vvp"],
      "timeout_seconds": 120
    },
    {
      "id": "fragment-residency", "kind": "compile",
      "argv": ["{python}", "compiler/test/test_fragment_residency.py", "-v"],
      "timeout_seconds": 120
    },
    {
      "id": "depthwise-and-column-broadcast", "kind": "systemc",
      "argv": ["{python}", "tools/performance_harness/test_depthwise.py", "-v"],
      "inputs": ["{home}/r41-stage1/runs/harness-smoke-v3/model-build/tnca-chip", "{root}/tools/performance_harness/systemc/configs/r40-board-m2.cfg"],
      "timeout_seconds": 600
    },
    {
      "id": "model-primitives", "kind": "systemc",
      "argv": ["{python}", "tools/performance_harness/primitive_cases.py", "--out", "{out}/primitives"],
      "inputs": ["{home}/r41-stage1/runs/harness-smoke-v3/model-build/tnca-chip", "{root}/tools/performance_harness/systemc/configs/r40-board-m2.cfg"],
      "outputs": ["{out}/primitives/report.json"],
      "timeout_seconds": 900
    }
  ]
}
