{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TritonChip FPGA SSH worker request",
  "type": "object",
  "required": [
    "schema_version",
    "operation",
    "board",
    "adapter",
    "manifest"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "operation": {
      "enum": [
        "doctor",
        "submit",
        "status",
        "export",
        "measure"
      ]
    },
    "board": {
      "enum": [
        "u50",
        "u280"
      ]
    },
    "adapter": {
      "enum": [
        "u50",
        "u280",
        "mock"
      ]
    },
    "manifest": {
      "$ref": "manifest.schema.json"
    },
    "state_dir": {
      "type": "string",
      "minLength": 1
    },
    "allow_dirty": {
      "type": "boolean"
    },
    "skip_board": {
      "type": "boolean"
    },
    "timeout": {
      "type": "integer",
      "minimum": 1
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "scope": {
      "enum": [
        "build",
        "board",
        "source"
      ]
    },
    "detach": {
      "type": "boolean"
    },
    "light": {
      "type": "boolean"
    },
    "allow_source_mismatch": {
      "type": "boolean"
    },
    "step": {
      "enum": [
        "submit",
        "measure"
      ]
    }
  },
  "additionalProperties": false
}
