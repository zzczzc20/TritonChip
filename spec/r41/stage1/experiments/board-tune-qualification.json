{
  "schema": "tnca-experiment-spec/1",
  "id": "board-tune-qualification",
  "allowed_hosts": [
    "acf3019"
  ],
  "hypothesis": "The public TNCA_TUNE path selects among at most four legal pointwise retiles on qualified physical device endpoints within the 600 s graph budget, reuses the persistent selection in a new process without measuring again, keeps tuning samples out of formal samples, and a forced device deadline in a bounded measurement scope poisons the Session until explicit recovery restores correct execution.",
  "competing_explanations": [
    "tuning silently retains the baseline because image/clock/memory-map identity is unavailable",
    "cache key misses across processes (placements or identity not reproducible)",
    "tuning launches leak into the formal timed calls",
    "a host wait expiry is treated as cancellation, or recovery reuses stale handles"
  ],
  "expected_counter_changes": [
    "first pass: per kernel <= 4 compiled candidates, 3 device samples each, cache_hit false",
    "rerun: cache_hit true with the same winner and no candidate measurement",
    "formal launches per timed call equal the generated graph launches",
    "deadline check: DeviceLost with poisoned Session, unchanged epoch, restored limits; epoch+1 after recover"
  ],
  "expected_observations": [
    "3 short pointwise R40-09.tune points pass in both passes; check report tuning-board-qualified; deadline-expiry report poison-and-recovery-pass"
  ],
  "plan": "spec/r41/stage1/plan.json",
