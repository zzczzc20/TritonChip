+    def _pad_e4m3_k32(self, a, b):
+        """Experimental: pad K16 to K32 with -0 × +1, preserving signed zero."""
+        v = self.b
+        aw = self._window_for(16, 32, a.dtype)
+        bw = self._window_for(32, 16, b.dtype)
+        lane = v.arange()
+        first = v.vcmp('lt', lane, v.vmovi(4))
+        second = v.pbin('and', v.vcmp('ge', lane, v.vmovi(8)),
+                        v.vcmp('lt', lane, v.vmovi(12)))
+        negative_zeros = v.vmovi(0x80808080, dtype='i32')
+        ones = v.vmovi(0x38383838, dtype='i32')
+        for i in range(8):
+            source = v.window_reg(a.handle, i // 2, dtype='i32')
+            low = v.vshuffle('down', source, v.const(8), dtype='i32') if i % 2 else source
+            high = v.vshuffle('down', source, v.const(4), dtype='i32') if i % 2 else \
+                v.vshuffle('up', source, v.const(4), dtype='i32')
+            padded = v.vselect(second, high, v.vselect(first, low, negative_zeros))
+            v.window_put(aw, i, padded)
+            v.window_put(bw, i, v.window_reg(b.handle, i, dtype='i32') if i < 4 else ones)
+        return Tile('window', aw, 16, 32, a.dtype), Tile('window', bw, 32, 16, b.dtype)
+
+    def _slice_e4m3_k64(self, a, b, start):
+        """Experimental: split packed K64 operands into ordered K32 windows."""
+        v = self.b
+        aw = self._window_for(16, 32, a.dtype)
+        bw = self._window_for(32, 16, b.dtype)
+        low_lanes = v.vcmp('lt', v.arange(), v.vmovi(8))
+        for i in range(8):
+            even = v.window_reg(a.handle, 2 * i, dtype='i32')
+            odd = v.window_reg(a.handle, 2 * i + 1, dtype='i32')
+            if start == 0:
+                odd = v.vshuffle('up', odd, v.const(8), dtype='i32')
+            else:
+                even = v.vshuffle('down', even, v.const(8), dtype='i32')
+            v.window_put(aw, i, v.vselect(low_lanes, even, odd))
+            if b.kind == 'row-chunks':
+                part = b.handle[start // 16 + i // 4]
+                right = v.window_reg(part.handle, i % 4, dtype='i32')
+            else:
+                right = v.window_reg(b.handle, i + start // 4, dtype='i32')
+            v.window_put(bw, i, right)
+        return Tile('window', aw, 16, 32, a.dtype), Tile('window', bw, 32, 16, b.dtype)
+
