  "competing_explanations": [
    "a point fails or falls back on the CPU and is silently dropped",
    "a large point is skipped or its workload reduced",
    "compiler changes alter placement/launch counts and hence timing without a code-quality change",
    "card state from earlier points leaks into later ones"
  ],
  "expected_counter_changes": [
    "launch counts and per-launch cycles change only where Stage 1 compiler changes apply (GEMM fragments, barriers)",
    "no new host fallback or upload/download inside resident calls"
  ],
  "expected_observations": [
    "113/113 records pass at their frozen tolerances; formal records follow the registered sampling rule",
    "missing or failing points remain listed as failures; no point is replaced"
  ],
